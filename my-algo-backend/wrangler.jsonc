{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-algo-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "ALGO_ROOM",
        "class_name": "AlgoRoom"
      },
      {
        "name": "MATCH_MAKER",
        "class_name": "MatchMaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AlgoRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MatchMaker"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-algo-db",
      "database_id": "e725297e-fb02-4c93-a6db-49a8caf25aa3"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://my-algo-web.pages.dev",
    "BACKEND_URL": "https://my-algo-backend.haruki1009kk.workers.dev",
    "COOKIE_SECURE": "true"
  }
}
